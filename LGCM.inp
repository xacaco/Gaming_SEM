TITLE:
    Quadratic LGCM of trait x by group, adjusting for sex and age;
DATA:
    FILE IS lgcm_data.dat;
VARIABLE:
    NAMES ARE
      pid
      x1 x2 x3 x4
      grp sex
      age1 age2 age3 age4;
    USEVARIABLES ARE
      x1 x2 x3 x4
      grp sex
      age1 age2 age3 age4;
    MISSING = .;
    GROUPING IS grp
      (0 = g0
       1 = g1);
ANALYSIS:
    ESTIMATOR = MLR;
MODEL:
    i s q | x1@0 x2@1 x3@2 x4@3;
    i ON sex;
    s ON sex;
    q ON sex;
    x1 ON age1;
    x2 ON age2;
    x3 ON age3;
    x4 ON age4;
MODEL g0:
    [i] (i0);
    [s] (s0);
    [q] (q0);
MODEL g1:
    [i] (i1);
    [s] (s1);
    [q] (q1);
MODEL TEST:
    0 = i0 - i1;
    0 = s0 - s1;
    0 = q0 - q1;
OUTPUT:
    SAMPSTAT STANDARDIZED TECH1 TECH4 CINTERVAL;
